+      key.scaled_resolve || key.format != xenos::TextureFormat::k_DXT4_5 ||
+      key.base_page > ((0x20000000u - fnr3::port::kGlyphTextureBytes) >> 12)) return;
+  auto found = fnr3_glyph_identities_.find(key.base_page);
+  if (found == fnr3_glyph_identities_.end()) {
