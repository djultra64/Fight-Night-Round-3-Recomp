+fnr3::port::NativeGlyphBridge* FNR3GlyphBridge() {
+  using Getter = fnr3::port::NativeGlyphBridge* (*)();
+  // Host export exists before the plugin is loaded. Resolve the function once;
+  // its result may remain null until guest memory/immutable assets are ready.
+  static const Getter getter = []() -> Getter {
+#if defined(_WIN32)
+    return reinterpret_cast<Getter>(GetProcAddress(GetModuleHandleW(nullptr), "Fnr3GetInputGlyphBridge"));
+#else
+    return reinterpret_cast<Getter>(dlsym(RTLD_DEFAULT, "Fnr3GetInputGlyphBridge"));
+#endif
+  }();
+  auto* bridge = getter ? getter() : nullptr;
+  return bridge && bridge->version == fnr3::port::kGlyphBridgeVersion ? bridge : nullptr;
