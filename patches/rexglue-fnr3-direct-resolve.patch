+// Host color image to Xenos tiled shared memory. Integration: djultra64.
+// Tiled address arithmetic derives from Xenia / ReXGlue texture/util.cpp
+// (BSD license; original dependency notices remain in the source tree).
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x=8,local_size_y=8) in;
+layout(set=0,binding=0,std430) writeonly buffer Destination { uint words[]; } dest;
+#ifdef MULTISAMPLED
+layout(set=1,binding=0) uniform texture2DMS source_image;
+#else
+layout(set=1,binding=0) uniform texture2D source_image;
+#endif
+layout(push_constant) uniform Push {
+ uint source_x; uint source_y; uint width; uint height;
+ uint dest_x; uint dest_y; uint dest_pitch; uint endian;
+ uint swap_rb; uint sample_first; uint sample_second; uint average_samples;
+} pc;
+uint tiled_offset(uint x,uint y,uint pitch) {
+ uint macro=((x>>5)+(y>>5)*(pitch>>5))<<9;
+ uint micro=((x&7)+((y&14)<<2))<<2;
+ uint offset=macro+((micro&~15u)<<1)+(micro&15u)+((y&1)<<4);
+ return ((offset&~511u)<<3)+((y&16)<<7)+((offset&448u)<<2)
+       +(((((y&8)>>2)+(x>>3))&3)<<6)+(offset&63u);
+}
+vec4 read_sample(ivec2 p,uint index) {
+#ifdef MULTISAMPLED
+ return texelFetch(source_image,p,int(index));
+#else
+ return texelFetch(source_image,p,0);
+#endif
+}
+void main() {
+ uvec2 pos=gl_GlobalInvocationID.xy;
+ if(any(greaterThanEqual(pos,uvec2(pc.width,pc.height)))) return;
+ ivec2 source=ivec2(pos+uvec2(pc.source_x,pc.source_y));
+ // Same UNORM8 quantization as GetDumpPipeline before the normal resolve.
+ uvec4 a=uvec4(clamp(read_sample(source,pc.sample_first),0.0,1.0)*255.0+0.5);
+ vec4 value=vec4(a)*(1.0/255.0);
+ if(pc.average_samples!=0) {
+  uvec4 b=uvec4(clamp(read_sample(source,pc.sample_second),0.0,1.0)*255.0+0.5);
+  value=(value+vec4(b)*(1.0/255.0))*0.5;
+ }
+ // Match the full resolve's floating-point normalize/pack operations.
+ uvec4 rgba=uvec4(clamp(value,0.0,1.0)*255.0+0.5);
+ if(pc.swap_rb!=0) rgba=rgba.bgra;
+ uint packed=rgba.r|(rgba.g<<8)|(rgba.b<<16)|(rgba.a<<24);
+ if(pc.endian==1 || pc.endian==2) packed=((packed&0x00FF00FFu)<<8)|((packed>>8)&0x00FF00FFu);
+ if(pc.endian==2 || pc.endian==3) packed=(packed<<16)|(packed>>16);
+ uint address=tiled_offset(pos.x+pc.dest_x,pos.y+pc.dest_y,pc.dest_pitch);
+ dest.words[address>>2]=packed;
+}
