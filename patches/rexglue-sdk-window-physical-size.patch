+void WindowSDL::RecordWindowedPixelSize(uint32_t width, uint32_t height) {
+  if (!width || !height) return;
+  windowed_pixel_width_ = width;
+  windowed_pixel_height_ = height;
+  windowed_pixel_density_ = GetPixelDensity();
+  SDL_GetWindowSize(sdl_window_, &windowed_coordinate_width_, nullptr);
+  OnDesiredLogicalSizeUpdate(SizeToLogical(width), SizeToLogical(height));
+}
+
+void WindowSDL::ApplyWindowedPixelSize() {
+  const float density = GetPixelDensity();
+  windowed_pixel_density_ = density;
+  windowed_pixel_size_pending_ = true;
+  if (!SDL_SetWindowSize(sdl_window_,
+                         std::max(1, int(std::lround(windowed_pixel_width_ / density))),
+                         std::max(1, int(std::lround(windowed_pixel_height_ / density)))) ||
+      !SDL_SyncWindow(sdl_window_)) {
+    // Retain the requested size for another display transition or reopen.
+    REXLOG_WARN("Physical window size could not be synchronized: {}", SDL_GetError());
+    return;
+  }
+  windowed_pixel_size_pending_ = false;
+  int width = 0, height = 0;
+  SDL_GetWindowSizeInPixels(sdl_window_, &width, &height);
+  if (width > 0 && height > 0) RecordWindowedPixelSize(uint32_t(width), uint32_t(height));
+  REXLOG_INFO("Window client {}x{} pixels, backing density {}, display scale {}",
+              width, height, density, SDL_GetWindowDisplayScale(sdl_window_));
+}
+
+void WindowSDL::UpdateWindowedPixelSize() {
+  const auto flags = SDL_GetWindowFlags(sdl_window_);
+  if (flags & (SDL_WINDOW_MAXIMIZED | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MINIMIZED)) return;
+  int coordinate_width = 0;
+  SDL_GetWindowSize(sdl_window_, &coordinate_width, nullptr);
+  // SDL derives density from rounded pixel_width / coordinate_width. A manual
+  // resize at fractional scaling can change that ratio by up to one pixel per
+  // measurement, without any change of output scale.
+  const float rounding_tolerance = 1.0f / std::max(1, coordinate_width) +
+                                   1.0f / std::max(1, windowed_coordinate_width_);
+  if (std::fabs(GetPixelDensity() - windowed_pixel_density_) > rounding_tolerance) {
+    ApplyWindowedPixelSize();
+    return;
+  }
+  // SDL event dimensions may precede a size request already applied while
+  // processing an earlier scale event. Read current pixels, not queued sizes.
+  int width = 0, height = 0;
+  SDL_GetWindowSizeInPixels(sdl_window_, &width, &height);
+  if (windowed_pixel_size_pending_) {
+    if (uint32_t(width) != windowed_pixel_width_ || uint32_t(height) != windowed_pixel_height_) return;
+    windowed_pixel_size_pending_ = false;
+  }
+  if (width > 0 && height > 0) RecordWindowedPixelSize(uint32_t(width), uint32_t(height));
+}
