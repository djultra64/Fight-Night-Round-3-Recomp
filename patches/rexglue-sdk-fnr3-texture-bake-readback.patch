+  static const Consume consume = []() -> Consume {
+#if defined(_WIN32)
+    return reinterpret_cast<Consume>(GetProcAddress(GetModuleHandleW(nullptr), "Fnr3ConsumeTextureBakeReadback"));
+#else
+    return reinterpret_cast<Consume>(dlsym(RTLD_DEFAULT, "Fnr3ConsumeTextureBakeReadback"));
+#endif
+  }();
+  return consume && consume(address, length);
+}

