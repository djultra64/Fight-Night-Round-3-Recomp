+// Integration by djultra64. Cache failure never changes draw behavior.
+void VulkanPipelineCache::InitializeDriverCache(const std::filesystem::path& root,
+                                               uint32_t title) {
+  CloseDriverCache();
+  std::unique_lock lock(driver_cache_mutex_);
+  if (!REXCVAR_GET(vulkan_persistent_pipeline_cache)) return;
+  auto* vk = command_processor_.GetVulkanDevice();
+  const auto& ifn = vk->vulkan_instance()->functions();
+  const VkDevice device = vk->device();
+  auto create = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkCreatePipelineCache"));
+  get_driver_cache_data_ = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      ifn.vkGetDeviceProcAddr(device, "vkGetPipelineCacheData"));
+  destroy_driver_cache_ = reinterpret_cast<PFN_vkDestroyPipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkDestroyPipelineCache"));
+  if (!create || !get_driver_cache_data_ || !destroy_driver_cache_) return;
+  VkPhysicalDeviceProperties props{};
+  ifn.vkGetPhysicalDeviceProperties(vk->physical_device(), &props);
+  driver_cache_identity_ = {props.vendorID, props.deviceID, props.driverVersion, {}};
+  std::copy_n(props.pipelineCacheUUID, VK_UUID_SIZE, driver_cache_identity_.uuid.begin());
+  auto dir = root / "vulkan-pipelines";
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  if (ec) return;
+  driver_cache_path_ = dir / fmt::format("{:08X}-{:08X}-{:08X}-{:08X}.bin",
+      title, props.vendorID, props.deviceID, props.driverVersion);
+  auto bytes = fnr3::pipeline_cache::Load(driver_cache_path_, driver_cache_identity_);
+  VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = bytes.size();
+  info.pInitialData = bytes.empty() ? nullptr : bytes.data();
+  auto result = create(device, &info, nullptr, &driver_cache_);
+  if (result != VK_SUCCESS && !bytes.empty()) {
+    bytes.clear();
+    driver_cache_ = VK_NULL_HANDLE;
+    info.initialDataSize = 0;
+    info.pInitialData = nullptr;
+    result = create(device, &info, nullptr, &driver_cache_);
+  }
+  if (result != VK_SUCCESS) {
+    driver_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("FNR3 pipeline binary cache unavailable: {}", int32_t(result));
+  } else {
+    REXGPU_WARN("FNR3 pipeline binary cache ready, {} validated bytes loaded", bytes.size());
+  }
+  driver_cache_generation_.store(0);
+  driver_cache_saved_generation_ = 0;
+  driver_cache_submissions_ = 0;
+}
+
+void VulkanPipelineCache::SaveDriverCache() {
+  std::vector<uint8_t> bytes;
+  uint64_t generation;
+  {
+    // Creation uses shared locks: Vulkan synchronizes concurrent creation with
+    // the default cache flags. GetData/destruction must exclude all creators.
+    std::unique_lock lock(driver_cache_mutex_);
+    generation = driver_cache_generation_.load();
+    if (!driver_cache_ || generation == driver_cache_saved_generation_) return;
+    auto device = command_processor_.GetVulkanDevice()->device();
+    size_t size = 0;
+    if (get_driver_cache_data_(device, driver_cache_, &size, nullptr) != VK_SUCCESS ||
+        size > fnr3::pipeline_cache::kMaxFileBytes - fnr3::pipeline_cache::kEnvelopeBytes) return;
+    bytes.resize(size);
+    if (get_driver_cache_data_(device, driver_cache_, &size, bytes.data()) != VK_SUCCESS) return;
+    bytes.resize(size);
+  }
+  if (fnr3::pipeline_cache::Save(driver_cache_path_, bytes, driver_cache_identity_)) {
+    driver_cache_saved_generation_ = generation;
+    REXGPU_WARN("FNR3 pipeline binary cache saved, {} bytes", bytes.size());
+  }
+}
+
+void VulkanPipelineCache::CloseDriverCache() {
+  SaveDriverCache();
+  std::unique_lock lock(driver_cache_mutex_);
+  if (driver_cache_ && destroy_driver_cache_) {
+    destroy_driver_cache_(command_processor_.GetVulkanDevice()->device(), driver_cache_, nullptr);
+  }
+  driver_cache_ = VK_NULL_HANDLE;
+  driver_cache_path_.clear();
+}
