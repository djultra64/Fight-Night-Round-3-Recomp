+      // Robust object mutexes also become recoverable when their owner dies.
+      // That transition has no signal publisher, so periodically recheck even
+      // an infinite wait. Normal signals wake immediately through generation.
+      // Retain the absolute deadline, including the outer 1 ms alertable slice.
+      auto recovery_deadline = now + std::chrono::milliseconds(10);
+      multi_wait_condition_.wait_until(wake_lock, std::min(end_time, recovery_deadline),
+                                      generation_changed);
