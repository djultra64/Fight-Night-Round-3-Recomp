+// Multi-wait predicates span several object mutexes. Publish a generation under
+// a separate mutex so a signal between predicate inspection and sleeping cannot
+// be lost. Never acquire an object mutex while holding multi_wait_mutex_.
+static std::mutex multi_wait_mutex_;
+static std::condition_variable multi_wait_condition_;
+static uint64_t multi_wait_generation_ = 0;
+
+static void NotifyMultiWaiters() {
+  {
+    std::lock_guard<std::mutex> lock(multi_wait_mutex_);
+    ++multi_wait_generation_;
+  }
+  multi_wait_condition_.notify_all();
+}
