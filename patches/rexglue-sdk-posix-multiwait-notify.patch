-        // Keep the steady-clock deadline precise and retain the polling bound.
-        std::this_thread::sleep_until(std::min(end_time, now + std::chrono::milliseconds(1)));
-      }
+      std::unique_lock<std::mutex> wake_lock(multi_wait_mutex_);
+      auto generation_changed = [&] {
+        return multi_wait_generation_ != observed_generation;
