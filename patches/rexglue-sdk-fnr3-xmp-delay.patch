 #include <rex/kernel/xam/apps/xmp_app.h>
 #include <rex/logging.h>
+#include <rex/cvar.h>
+#include <chrono>
 #include <rex/system/xthread.h>
 #include <rex/thread.h>
 
+REXCVAR_DEFINE_BOOL(fnr3_xmp_no_delay, false, "FNR3/Performance",
+                    "Replace artificial XMP worker delays with a scheduler yield")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(fnr3_xmp_trace, false, "FNR3/Diagnostics",
+                    "Count XMP polling calls and delay time per host thread");
+
+namespace {
+// Project integration by djultra64. This changes only the SDK's throttle,
+// never an event, fence, response value or game audio-bank wait.
+// FNR3_XMP_DELAY_BEGIN
+void Fnr3XmpDelay(bool main_thread, uint32_t delay_ms) {
+  const bool skip = REXCVAR_GET(fnr3_xmp_no_delay);
+  const bool trace = REXCVAR_GET(fnr3_xmp_trace);
+  auto apply = [&] {
+    if (!main_thread) {
+      if (skip) rex::thread::MaybeYield();
+      else rex::thread::Sleep(std::chrono::milliseconds(delay_ms));
+    }
+  };
+  if (!trace) { apply(); return; }
+  struct Counts {
+    uint64_t calls = 0, worker_calls = 0, status = 0, controller = 0;
+    double delay_us = 0;
+    std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+  };
+  thread_local Counts count;
+  auto began = std::chrono::steady_clock::now();
+  apply();
+  auto now = std::chrono::steady_clock::now();
+  ++count.calls;
+  count.worker_calls += !main_thread;
+  count.status += delay_ms == 1;
+  count.controller += delay_ms == 10;
+  count.delay_us += std::chrono::duration<double, std::micro>(now - began).count();
+  const double seconds = std::chrono::duration<double>(now - count.since).count();
+  if (count.calls == 1 || seconds >= 2.0) {
+    REXKRNL_INFO("FNR3_XMP calls={} worker={} status={} controller={} seconds={:.3f} delay_ms={:.3f} no_delay={}",
+        count.calls, count.worker_calls, count.status, count.controller, seconds, count.delay_us / 1000.0, skip);
+    if (seconds >= 2.0) count = Counts{};
+  }
+}
+// FNR3_XMP_DELAY_END
+}  // namespace
+
 namespace rex {
 namespace kernel {
 namespace xam {
