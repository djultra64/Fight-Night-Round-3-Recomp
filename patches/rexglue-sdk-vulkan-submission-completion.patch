+// Fence allocation or a separate fence signal can fail after work was queued.
+// A cold-path queue wait proves completion without inventing a tracker signal.
+// False means device loss; other failures are terminal, never endless retries.
+bool AwaitGraphicsSubmission(const VulkanDevice* vulkan_device,
+                             VulkanSubmissionTracker& tracker, uint64_t submission_index) {
+  if (tracker.AwaitSubmissionCompletion(submission_index)) {
+    return true;
+  }
+  VkResult idle_result;
+  {
+    const VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    idle_result = vulkan_device->functions().vkQueueWaitIdle(queue_acquisition.queue());
+  }
+  if (idle_result == VK_SUCCESS) {
+    static std::atomic_flag reported = ATOMIC_FLAG_INIT;
+    if (!reported.test_and_set(std::memory_order_relaxed)) {
+      REXLOG_WARN("VulkanPresenter: queue idle proved completion after an unproven fence for submission {}",
+                  submission_index);
+    }
+    return true;
+  }
+  REXLOG_ERROR("VulkanPresenter: queue completion for submission {} failed: {}",
+               submission_index, int32_t(idle_result));
+  if (idle_result == VK_ERROR_DEVICE_LOST) {
+    return false;
+  }
+  rex::FatalError("Cannot confirm completion of Vulkan presentation work");
+}
