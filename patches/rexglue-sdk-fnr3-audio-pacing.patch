diff --git a/include/rex/audio/frame_pacer.h b/include/rex/audio/frame_pacer.h
new file mode 100644
--- /dev/null
+++ b/include/rex/audio/frame_pacer.h
@@ -0,0 +1,27 @@
+// Audio sample-clock pacing for FNR3. Project integration: djultra64.
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::audio {
+class FramePacer {
+ public:
+  using Clock=std::chrono::steady_clock;
+  Clock::time_point Schedule(Clock::time_point now) {
+    constexpr auto interval=std::chrono::nanoseconds(UINT64_C(1000000000)*256/48000);
+    // A short startup cushion covers the device's four-frame callback quantum.
+    if (priming_) {
+      --priming_;
+      next_=now+interval;
+      return now;
+    }
+    const auto due=std::max(now,next_);
+    next_=due+interval;
+    return due;
+  }
+ private:
+  uint32_t priming_=4;
+  Clock::time_point next_{};
+};
+}  // namespace rex::audio
