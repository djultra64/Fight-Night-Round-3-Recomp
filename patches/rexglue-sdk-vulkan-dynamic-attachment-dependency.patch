+// Dynamic rendering has no render-pass external subpass dependencies.
+// Preserve framebuffer-local ordering when reopening attachment usage without
+// a layout transition. Draws within one rendering instance keep their fast path.
+static void SynchronizeDynamicRenderingAttachments(DeferredCommandBuffer& commands,
+                                                   bool color, bool depth_stencil) {
+  VkPipelineStageFlags stages = 0;
+  VkAccessFlags access = 0;
+  if (color) {
+    stages |= VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    access |= VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  }
+  if (depth_stencil) {
+    stages |= VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+    access |= VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+  }
+  if (!stages) {
+    return;
+  }
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask = access;
+  barrier.dstAccessMask = access;
+  commands.CmdVkPipelineBarrier(stages, stages, VK_DEPENDENCY_BY_REGION_BIT,
+                               1, &barrier, 0, nullptr, 0, nullptr);
+}
